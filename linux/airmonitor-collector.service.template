[Unit]
Description=AirMonitor sensor collector (native, non-Docker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__AIRMONITOR_DIR__/collector
Environment=SENSORS_CONFIG=__AIRMONITOR_DIR__/../config/sensors.json
Environment=DATA_DIR=__AIRMONITOR_DIR__/../data
ExecStart=__AIRMONITOR_DIR__/venv/bin/python __AIRMONITOR_DIR__/collector/run_collector.py
Restart=on-failure
RestartSec=5
# SENSOR_API_KEY, CRON_SCHEDULE, TZ etc. are read directly from
# __AIRMONITOR_DIR__/../.env by the script itself - nothing else needed here.

[Install]
WantedBy=multi-user.target
